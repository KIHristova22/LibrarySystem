@{
    ViewData["Title"] = "Sign in";
}

<div class="auth-page">
    <section class="auth-card">
        <div class="auth-card-heading">
            <span class="auth-icon" aria-hidden="true">↗</span>
            <p class="eyebrow">WELCOME BACK</p>
            <h1>Sign in</h1>
            <p>Sign in to manage your account and borrow books.</p>
        </div>

        <form asp-controller="Account"
              asp-action="Login"
              asp-route-returnUrl="@ViewData["ReturnUrl"]"
              method="post">
            <div asp-validation-summary="All" class="validation-summary" role="alert"></div>

            <div class="mb-3">
                <label for="email" class="form-label">Email address</label>
                <input id="email" name="email" type="email" class="form-control"
                       autocomplete="email" required placeholder="you@example.com" />
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input id="password" name="password" type="password" class="form-control"
                       autocomplete="current-password" required placeholder="Your password" />
            </div>

            <button type="submit" class="btn btn-accent w-100">Sign in</button>
        </form>

        <p class="auth-switch">
            New to the library?
            <a asp-action="Register">Create an account</a>
        </p>
    </section>
</div>