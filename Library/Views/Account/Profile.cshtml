@model Library.Models.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
    var displayName = Model.UserName ?? Model.Email ?? "Reader";
    var initials = string.Join(
        "",
        displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(part => part[0].ToString().ToUpperInvariant()));
}

<div class="profile-page">
    <div class="profile-heading">
        <div>
            <p class="eyebrow">YOUR ACCOUNT</p>
            <h1>My Profile</h1>
            <p class="text-secondary mb-0">Manage your reader information and profile picture.</p>
        </div>
    </div>

    @if (TempData["ProfileMessage"] is string message)
    {
        <div class="alert alert-success" role="status">@message</div>
    }

    <section class="profile-card">
        <div class="profile-summary">
            @if (!string.IsNullOrWhiteSpace(Model.ProfilePictureUrl))
            {
                <img class="profile-avatar" src="@Model.ProfilePictureUrl" alt="Profile picture" />
            }
            else
            {
                <div class="profile-avatar profile-avatar-fallback" aria-label="Profile initials">
                    @(string.IsNullOrWhiteSpace(initials) ? "R" : initials)
                </div>
            }

            <div>
                <h2>@displayName</h2>
                <p>@Model.Email</p>
                <span class="reader-badge">Library reader</span>
            </div>
        </div>

        <hr class="profile-divider" />

        <div asp-validation-summary="All" class="validation-summary" role="alert"></div>

        <dl class="profile-details">
            <div>
                <dt>Email address</dt>
                <dd>@(Model.Email ?? "Not provided")</dd>
            </div>
            <div>
                <dt>Username</dt>
                <dd>@(Model.UserName ?? "Not provided")</dd>
            </div>
        </dl>

        <form asp-controller="Account"
              asp-action="Profile"
              method="post"
              enctype="multipart/form-data"
              class="profile-upload-form">
            <div>
                <h3>Profile picture</h3>
                <p>Upload a JPG or PNG image. Maximum file size: 5 MB.</p>
            </div>

            <label asp-for="ProfilePicture" class="form-label">Choose an image</label>
            <input asp-for="ProfilePicture" type="file" class="form-control"
                   accept=".jpg,.png,image/jpeg,image/png" />
            <span asp-validation-for="ProfilePicture" class="field-validation"></span>

            <button type="submit" class="btn btn-accent mt-3">Update picture</button>
        </form>
    </section>
</div>