@model Library.Models.Author

@{
    ViewData["Title"] = "Add New Author";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="mb-4">
                <p class="text-uppercase text-secondary small fw-bold mb-1">Library catalogue</p>
                <h1 class="h2 fw-bold mb-1">Add a new author</h1>
                <p class="text-secondary mb-0">Add an author to make them available when creating books.</p>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form asp-controller="Authors" asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="FirstName" class="form-label fw-semibold">First name</label>
                            <input asp-for="FirstName"
                                   class="form-control"
                                   autocomplete="given-name"
                                   maxlength="100"
                                   placeholder="Enter the author's first name" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="LastName" class="form-label fw-semibold">Last name</label>
                            <input asp-for="LastName"
                                   class="form-control"
                                   autocomplete="family-name"
                                   maxlength="100"
                                   placeholder="Enter the author's last name" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>

                        <div class="d-flex flex-wrap justify-content-between gap-2">
                            <a asp-controller="Authors"
                               asp-action="Index"
                               class="btn btn-light">Cancel</a>

                            <button type="submit" class="btn btn-primary px-4">
                                Save author
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}