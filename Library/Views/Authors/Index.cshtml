@model IEnumerable<Library.Models.Author>

@{
    ViewData["Title"] = "Authors";
    var authors = Model?.ToList() ?? new List<Library.Models.Author>();
    var isAdmin = User.IsInRole("Admin");
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <p class="text-uppercase text-secondary small fw-bold mb-1">Library catalogue</p>
            <h1 class="h2 fw-bold mb-1">Authors</h1>
            <p class="text-secondary mb-0">Browse the authors represented in the collection.</p>
        </div>

        @if (isAdmin)
        {
            <a asp-controller="Authors"
               asp-action="Create"
               class="btn btn-primary">
                + Add New Author
            </a>
        }
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show" role="status">
            @success
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="py-3 ps-4">First name</th>
                        <th class="py-3">Last name</th>
                        @if (isAdmin)
                        {
                            <th class="py-3 text-end pe-4">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (authors.Count == 0)
                    {
                        <tr>
                            <td colspan="@(isAdmin ? 3 : 2)" class="text-center py-5">
                                <h2 class="h5 fw-semibold">No authors yet</h2>
                                <p class="text-secondary mb-0">Authors will appear here after they are added.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var author in authors)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">@author.FirstName</td>
                                <td>@author.LastName</td>

                                @if (isAdmin)
                                {
                                    <td class="text-end pe-4 text-nowrap">
                                        <a asp-controller="Authors"
                                           asp-action="Edit"
                                           asp-route-id="@author.AuthorId"
                                           class="text-decoration-none me-3">Edit</a>

                                        <a asp-controller="Authors"
                                           asp-action="Delete"
                                           asp-route-id="@author.AuthorId"
                                           class="text-danger text-decoration-none">Delete</a>
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>