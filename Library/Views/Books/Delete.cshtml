@model Library.Models.Book

@{
    ViewData["Title"] = "Delete Book";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-danger shadow-sm">
                <div class="card-body p-4">
                    <h3 class="fw-bold text-danger mb-3">Delete Book</h3>
                    <p class="text-muted">Are you sure you want to delete this book from the catalog?</p>

                    <dl class="row mb-4">
                        <dt class="col-sm-4 fw-semibold">Title</dt>
                        <dd class="col-sm-8">@Model.Title</dd>

                        <dt class="col-sm-4 fw-semibold">Author</dt>
                        <dd class="col-sm-8">@(Model.Author != null ? $"{Model.Author.FirstName} {Model.Author.LastName}" : "Unknown")</dd>

                        <dt class="col-sm-4 fw-semibold">Category</dt>
                        <dd class="col-sm-8">@(Model.Category != null ? Model.Category.Name : "None")</dd>

                        <dt class="col-sm-4 fw-semibold">Price</dt>
                        <dd class="col-sm-8">$@Model.Price.ToString("0.00")</dd>
                    </dl>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="BookId" />
                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-danger px-4">Confirm Delete</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>