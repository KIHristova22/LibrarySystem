@model Library.Models.Book

@{
    ViewData["Title"] = "Book Details";
    var isAdmin = User.IsInRole("Admin");
    var isUser = User.Identity?.IsAuthenticated == true
                 && User.IsInRole("User")
                 && !isAdmin;
    var isBorrowed = ViewBag.IsBorrowed is bool borrowed && borrowed;
}

<div class="container py-4">
    <h2>Book Details</h2>

    <dl class="row mt-3">
        <dt class="col-sm-3">Title</dt>
        <dd class="col-sm-9">@Model.Title</dd>

        <dt class="col-sm-3">Author</dt>
        <dd class="col-sm-9">
            @(Model.Author != null
                ? $"{Model.Author.FirstName} {Model.Author.LastName}"
                : "Unknown")
        </dd>

        <dt class="col-sm-3">Category</dt>
        <dd class="col-sm-9">@(Model.Category?.Name ?? "None")</dd>

        <dt class="col-sm-3">Price</dt>
        <dd class="col-sm-9">$@Model.Price.ToString("0.00")</dd>

        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <dt class="col-sm-3">Cover</dt>
            <dd class="col-sm-9">
                <img src="@Model.ImageUrl"
                     alt="Cover of @Model.Title"
                     style="max-width:180px; max-height:240px; object-fit:cover;" />
            </dd>
        }
    </dl>

    @if (isAdmin)
    {
        <a asp-action="Edit" asp-route-id="@Model.BookId" class="btn btn-primary">Edit</a>
        <a asp-action="Delete" asp-route-id="@Model.BookId" class="btn btn-danger">Delete</a>
    }
    else if (isUser)
    {
        if (isBorrowed)
        {
            <span class="badge bg-secondary">This book is already borrowed</span>
        }
        else
        {
            <form asp-action="Borrow" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.BookId" />
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success">Borrow</button>
            </form>
        }
    }

    <a asp-action="Index" class="btn btn-outline-secondary">Back to books</a>
</div>