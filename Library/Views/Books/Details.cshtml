@model Library.Models.Book

@{
    ViewData["Title"] = Model.Title;
    var isAdmin = User.IsInRole("Admin");
    var isUser = User.Identity?.IsAuthenticated == true && User.IsInRole("User") && !isAdmin;
    var isBorrowed = ViewBag.IsBorrowed is bool borrowed && borrowed;
}

<div class="container pb-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
        <div>
            <p class="eyebrow">Book Details</p>
            <h1 class="h2 fw-bold mb-0">@Model.Title</h1>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">← Back to books</a>
    </div>

    <div class="book-list-card">
        <div class="row g-0">
            <div class="col-auto p-4 d-flex align-items-start justify-content-center" style="min-width: 160px;">
                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl"
                         alt="Cover of @Model.Title"
                         class="rounded"
                         style="width: 140px; height: 190px; object-fit: cover; box-shadow: 0 4px 14px rgb(23 32 51 / 16%);" />
                }
                else
                {
                    <div class="book-cover-placeholder" style="width: 140px; height: 190px; font-size: 0.8rem;">
                        No cover
                    </div>
                }
            </div>

            <div class="col p-4 d-flex flex-column" style="min-width: 0;">
                <dl class="row mb-auto">
                    <dt class="col-sm-3 text-muted small fw-semibold text-uppercase" style="letter-spacing:.05em;">Author</dt>
                    <dd class="col-sm-9 fw-semibold">
                        @(Model.Author != null ? $"{Model.Author.FirstName} {Model.Author.LastName}" : "Unknown")
                    </dd>

                    <dt class="col-sm-3 text-muted small fw-semibold text-uppercase" style="letter-spacing:.05em;">Category</dt>
                    <dd class="col-sm-9">
                        @if (Model.Category != null)
                        {
                            <span class="category-pill">@Model.Category.Name</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </dd>

                    <dt class="col-sm-3 text-muted small fw-semibold text-uppercase" style="letter-spacing:.05em;">Price</dt>
                    <dd class="col-sm-9 book-price">$@Model.Price.ToString("0.00")</dd>

                    <dt class="col-sm-3 text-muted small fw-semibold text-uppercase" style="letter-spacing:.05em;">Status</dt>
                    <dd class="col-sm-9">
                        @if (isBorrowed)
                        {
                            <span class="status-pill status-borrowed">Currently borrowed</span>
                        }
                        else
                        {
                            <span class="status-pill status-available">Available</span>
                        }
                    </dd>
                </dl>

                <div class="d-flex flex-wrap gap-2 pt-3 mt-3 border-top">
                    @if (isAdmin)
                    {
                        <a asp-action="Edit" asp-route-id="@Model.BookId" class="btn btn-primary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@Model.BookId" class="btn btn-outline-danger">Delete</a>
                    }
                    else if (isUser)
                    {
                        @if (isBorrowed)
                        {
                            <span class="status-pill status-borrowed align-self-center">Already borrowed</span>
                        }
                        else
                        {
                            <form asp-action="Borrow" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@Model.BookId" />
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-success">Borrow this book</button>
                            </form>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>
