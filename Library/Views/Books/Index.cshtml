@model IEnumerable<Library.Models.Book>

@{
    ViewData["Title"] = "Books";
    var books = Model?.ToList() ?? new List<Library.Models.Book>();
    var currentPage = ViewBag.CurrentPage is int cp ? cp : 1;
    var totalPages = ViewBag.TotalPages is int tp ? tp : 1;
    var borrowedBookIds = ViewBag.BorrowedBookIds as List<int> ?? new List<int>();
    var categories = ViewBag.Categories as List<Library.Models.Category> ?? new List<Library.Models.Category>();
    var searchString = ViewBag.SearchString as string ?? string.Empty;
    var categoryId = ViewBag.CategoryId as int?;
    var onlyAvailable = ViewBag.OnlyAvailable is bool available && available;
    var sortOrder = ViewBag.SortOrder as string ?? string.Empty;
    var isAdmin = User.IsInRole("Admin");
    var isUser = User.Identity?.IsAuthenticated == true && User.IsInRole("User") && !isAdmin;
    var colCount = 5 + (isUser ? 1 : 0) + (isAdmin ? 1 : 0);
}

<div class="container pb-4">
    <div class="catalogue-heading">
        <div>
            <p class="eyebrow">Library Catalogue</p>
            <h1>Books</h1>
        </div>
        @if (isAdmin)
        {
            <a asp-action="Create" class="btn btn-accent">+ Add Book</a>
        }
    </div>

    <form asp-action="Index" method="get" class="book-list-card p-3 mb-3">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label for="searchString" class="form-label">Title</label>
                <input id="searchString"
                       name="searchString"
                       value="@searchString"
                       class="form-control"
                       placeholder="Search by title" />
            </div>

            <div class="col-md-3">
                <label for="categoryId" class="form-label">Category</label>
                <select id="categoryId" name="categoryId" class="form-select">
                    <option value="">All categories</option>
                    @foreach (var cat in categories)
                    {
                        if (categoryId == cat.CategoryId)
                        {
                            <option value="@cat.CategoryId" selected>@cat.Name</option>
                        }
                        else
                        {
                            <option value="@cat.CategoryId">@cat.Name</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-2">
                <label for="sortOrder" class="form-label">Sort by</label>
                @{
                    (string val, string label)[] sortOpts =
                    {
                        ("",           "Name: A–Z"),
                        ("name_desc",  "Name: Z–A"),
                        ("date",       "Date: Oldest first"),
                        ("date_desc",  "Date: Newest first"),
                        ("price",      "Price: Low to high"),
                        ("price_desc", "Price: High to low")
                    };
                }
                <select id="sortOrder" name="sortOrder" class="form-select">
                    @foreach (var (val, label) in sortOpts)
                    {
                        if (sortOrder == val)
                        {
                            <option value="@val" selected>@label</option>
                        }
                        else
                        {
                            <option value="@val">@label</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-2 d-flex align-items-end pb-1">
                <div class="form-check">
                    <input id="onlyAvailable"
                           name="onlyAvailable"
                           type="checkbox"
                           value="true"
                           class="form-check-input"
                           checked="@(onlyAvailable ? "checked" : null)" />
                    <label for="onlyAvailable" class="form-check-label fw-semibold">
                        Available only
                    </label>
                </div>
            </div>

            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Apply</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
            </div>
        </div>
    </form>

    <div class="book-list-card mb-3">
        <div class="table-responsive">
            <table class="table book-table mb-0">
                <thead>
                    <tr>
                        <th class="cover-column"></th>
                        <th>Title</th>
                        <th>Author</th>
                        <th>Category</th>
                        <th>Price</th>
                        @if (isUser)
                        {
                            <th class="text-center">Borrow</th>
                        }
                        @if (isAdmin)
                        {
                            <th class="text-center">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (!books.Any())
                    {
                        <tr>
                            <td colspan="@colCount">
                                <div class="empty-state">
                                    <div class="empty-state-icon">📚</div>
                                    <h2>No books found</h2>
                                    <p>Try adjusting your filters or add a new book to the catalogue.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in books)
                        {
                            var isBorrowed = borrowedBookIds.Contains(item.BookId);
                            <tr>
                                <td class="cover-column">
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="Cover of @item.Title" class="book-cover" />
                                    }
                                    else
                                    {
                                        <div class="book-cover-placeholder">No cover</div>
                                    }
                                </td>

                                <td>
                                    <a asp-action="Details" asp-route-id="@item.BookId" class="book-title text-decoration-none">
                                        @item.Title
                                    </a>
                                </td>

                                <td>@(item.Author != null ? $"{item.Author.FirstName} {item.Author.LastName}" : "—")</td>

                                <td>
                                    @if (item.Category != null)
                                    {
                                        <span class="category-pill">@item.Category.Name</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>

                                <td class="book-price">$@item.Price.ToString("0.00")</td>

                                @if (isUser)
                                {
                                    <td class="text-center">
                                        @if (isBorrowed)
                                        {
                                            <span class="status-pill status-borrowed">Borrowed</span>
                                        }
                                        else
                                        {
                                            <form asp-action="Borrow" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@item.BookId" />
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-success">Borrow</button>
                                            </form>
                                        }
                                    </td>
                                }

                                @if (isAdmin)
                                {
                                    <td class="text-center text-nowrap">
                                        <a asp-action="Details" asp-route-id="@item.BookId" class="table-action">Details</a>
                                        <a asp-action="Edit" asp-route-id="@item.BookId" class="table-action">Edit</a>
                                        <a asp-action="Delete" asp-route-id="@item.BookId" class="table-action table-action-danger">Delete</a>
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="catalogue-pagination">
        <span class="text-muted small">Page @currentPage of @totalPages</span>

        @if (totalPages > 1)
        {
            <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(currentPage - 1)"
                           asp-route-searchString="@searchString"
                           asp-route-categoryId="@categoryId"
                           asp-route-onlyAvailable="@(onlyAvailable ? true : null)"
                           asp-route-sortOrder="@sortOrder">‹ Prev</a>
                    </li>

                    @for (var i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(currentPage == i ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@i"
                               asp-route-searchString="@searchString"
                               asp-route-categoryId="@categoryId"
                               asp-route-onlyAvailable="@(onlyAvailable ? true : null)"
                               asp-route-sortOrder="@sortOrder">@i</a>
                        </li>
                    }

                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(currentPage + 1)"
                           asp-route-searchString="@searchString"
                           asp-route-categoryId="@categoryId"
                           asp-route-onlyAvailable="@(onlyAvailable ? true : null)"
                           asp-route-sortOrder="@sortOrder">Next ›</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>
