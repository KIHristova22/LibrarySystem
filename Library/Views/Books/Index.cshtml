@model IEnumerable<Library.Models.Book>

@{
    ViewData["Title"] = "Book Register";
    var books = Model?.ToList() ?? new List<Library.Models.Book>();
    var currentPage = ViewBag.CurrentPage is int cp ? cp : 1;
    var totalPages = ViewBag.TotalPages is int tp ? tp : 1;
    var borrowedBookIds = ViewBag.BorrowedBookIds as List<int> ?? new List<int>();

    var categories = ViewBag.Categories as List<Library.Models.Category>
                     ?? new List<Library.Models.Category>();

    var searchString = ViewBag.SearchString as string ?? string.Empty;
    var categoryId = ViewBag.CategoryId as int?;
    var onlyAvailable = ViewBag.OnlyAvailable is bool available && available;
    var sortOrder = ViewBag.SortOrder as string ?? string.Empty;

    var isAdmin = User.IsInRole("Admin");
    var isUser = User.Identity?.IsAuthenticated == true
                 && User.IsInRole("User")
                 && !isAdmin;
}

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h2 class="fw-bold text-dark mb-0">Book Register</h2>

        @if (isAdmin)
        {
            <a asp-action="Create" class="btn btn-outline-dark shadow-sm">+ Add Book</a>
        }
    </div>

    <form asp-action="Index" method="get" class="card card-body mb-3">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label for="searchString" class="form-label">Book title</label>
                <input id="searchString"
                       name="searchString"
                       value="@searchString"
                       class="form-control"
                       placeholder="Search title" />
            </div>

            <div class="col-md-3">
                <label for="categoryId" class="form-label">Category</label>
                <select id="categoryId" name="categoryId" class="form-select">
                    <option value="">All categories</option>

                    @foreach (var category in categories)
                    {
                        if (categoryId == category.CategoryId)
                        {
                            <option value="@category.CategoryId" selected>
                                @category.Name
                            </option>
                        }
                        else
                        {
                            <option value="@category.CategoryId">
                                @category.Name
                            </option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-2">
                <label for="sortOrder" class="form-label">Sort by</label>
                <select id="sortOrder" name="sortOrder" class="form-select">
                    @if (sortOrder == "name_desc")
                    {
                        <option value="">Name: A–Z</option>
                        <option value="name_desc" selected>Name: Z–A</option>
                        <option value="date">Date: Oldest first</option>
                        <option value="date_desc">Date: Newest first</option>
                        <option value="price">Price: Low to high</option>
                        <option value="price_desc">Price: High to low</option>
                    }
                    else if (sortOrder == "date")
                    {
                        <option value="">Name: A–Z</option>
                        <option value="name_desc">Name: Z–A</option>
                        <option value="date" selected>Date: Oldest first</option>
                        <option value="date_desc">Date: Newest first</option>
                        <option value="price">Price: Low to high</option>
                        <option value="price_desc">Price: High to low</option>
                    }
                    else if (sortOrder == "date_desc")
                    {
                        <option value="">Name: A–Z</option>
                        <option value="name_desc">Name: Z–A</option>
                        <option value="date">Date: Oldest first</option>
                        <option value="date_desc" selected>Date: Newest first</option>
                        <option value="price">Price: Low to high</option>
                        <option value="price_desc">Price: High to low</option>
                    }
                    else if (sortOrder == "price")
                    {
                        <option value="">Name: A–Z</option>
                        <option value="name_desc">Name: Z–A</option>
                        <option value="date">Date: Oldest first</option>
                        <option value="date_desc">Date: Newest first</option>
                        <option value="price" selected>Price: Low to high</option>
                        <option value="price_desc">Price: High to low</option>
                    }
                    else if (sortOrder == "price_desc")
                    {
                        <option value="">Name: A–Z</option>
                        <option value="name_desc">Name: Z–A</option>
                        <option value="date">Date: Oldest first</option>
                        <option value="date_desc">Date: Newest first</option>
                        <option value="price">Price: Low to high</option>
                        <option value="price_desc" selected>Price: High to low</option>
                    }
                    else
                    {
                        <option value="" selected>Name: A–Z</option>
                        <option value="name_desc">Name: Z–A</option>
                        <option value="date">Date: Oldest first</option>
                        <option value="date_desc">Date: Newest first</option>
                        <option value="price">Price: Low to high</option>
                        <option value="price_desc">Price: High to low</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <div class="form-check mt-4">
                    <input id="onlyAvailable"
                           name="onlyAvailable"
                           type="checkbox"
                           value="true"
                           class="form-check-input"
                           checked="@(onlyAvailable ? "checked" : null)" />
                    <label for="onlyAvailable" class="form-check-label">
                        Available only
                    </label>
                </div>
            </div>

            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Apply</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
            </div>
        </div>
    </form>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-primary shadow-sm mb-3">
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle mb-0 bg-white">
                <thead class="table-primary text-dark">
                    <tr>
                        <th class="py-3 ps-3" style="width: 90px;">Thumbnail</th>
                        <th class="py-3">Title</th>
                        <th class="py-3">Author</th>
                        <th class="py-3">Category</th>
                        <th class="py-3">Price</th>

                        @if (isUser)
                        {
                            <th class="py-3 text-center">Borrow</th>
                        }

                        @if (isAdmin)
                        {
                            <th class="py-3 text-center">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (!books.Any())
                    {
                        <tr>
                            <td colspan="@(5 + (isUser ? 1 : 0) + (isAdmin ? 1 : 0))" class="text-center py-4 text-muted">
                                No books added yet.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in books)
                        {
                            var isBorrowed = borrowedBookIds.Contains(item.BookId);

                            <tr>
                                <td class="ps-3">
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="Cover of @item.Title" style="width: 45px; height: 60px; object-fit: cover;" class="rounded shadow-sm" />
                                    }
                                    else
                                    {
                                        <span class="text-muted small">No Image</span>
                                    }
                                </td>

                                <td class="fw-semibold">@item.Title</td>

                                <td>@(item.Author != null ? $"{item.Author.FirstName} {item.Author.LastName}" : "Unknown")</td>

                                <td>@(item.Category != null ? item.Category.Name : "None")</td>

                                <td>$@item.Price.ToString("0.00")</td>

                                @if (isUser)
                                {
                                    <td class="text-center">
                                        @if (isBorrowed)
                                        {
                                            <span class="badge bg-secondary">Borrowed</span>
                                        }
                                        else
                                        {
                                            <form asp-action="Borrow" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@item.BookId" />
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-success">Borrow</button>
                                            </form>
                                        }
                                    </td>
                                }

                                @if (isAdmin)
                                {
                                    <td class="text-center">
                                        <a asp-action="Edit" asp-route-id="@item.BookId" class="text-primary text-decoration-none me-2">Edit</a>
                                        <span class="text-muted">|</span>
                                        <a asp-action="Delete" asp-route-id="@item.BookId" class="text-danger text-decoration-none mx-2">Delete</a>
                                        <span class="text-muted">|</span>
                                        <a asp-action="Details" asp-route-id="@item.BookId" class="text-decoration-none ms-2">Details</a>
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
        <div class="text-muted small">
            Page @currentPage of @totalPages
        </div>

        @if (totalPages > 1)
        {
            <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(currentPage - 1)"
                           asp-route-searchString="@searchString"
                           asp-route-categoryId="@categoryId"
                           asp-route-onlyAvailable="@(onlyAvailable ? true : null)"
                           asp-route-sortOrder="@sortOrder">Previous</a>
                    </li>

                    @for (var i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(currentPage == i ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@i"
                               asp-route-searchString="@searchString"
                               asp-route-categoryId="@categoryId"
                               asp-route-onlyAvailable="@(onlyAvailable ? true : null)"
                               asp-route-sortOrder="@sortOrder">@i</a>
                        </li>
                    }

                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(currentPage + 1)"
                           asp-route-searchString="@searchString"
                           asp-route-categoryId="@categoryId"
                           asp-route-onlyAvailable="@(onlyAvailable ? true : null)"
                           asp-route-sortOrder="@sortOrder">Next</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>