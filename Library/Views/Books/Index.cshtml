@model IEnumerable<Library.Models.Book>

@{
    ViewData["Title"] = "Book Catalog";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 fw-bold">Book Catalog</h1>
        <a asp-action="Create" class="btn btn-success shadow-sm">
            Add New Book
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
            <tr>
                <th class="ps-4">Title</th>
                <th>Price</th>
                <th class="text-end pe-4">Actions</th>
            </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="3" class="text-center py-4 text-muted">No books added yet.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model) {
                    <tr>
                        <td class="ps-4 fw-semibold">@item.Title</td>
                        <td><span>@item.Price.ToString("0.00")</span></td>
                        <td class="text-end pe-4">
                            <a asp-action="Edit" asp-route-id="@item.BookId" class="btn btn-sm btn-outline-warning me-1">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.BookId" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>