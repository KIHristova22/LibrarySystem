@model IEnumerable<Library.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Categories</h2>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-outline-dark">+ Add Category</a>
        }
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Category Name</th>
                        @if (User.IsInRole("Admin"))
                        {
                            <th class="text-end pe-4">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="2" class="text-center py-4 text-muted">No categories added yet.</td></tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">@item.Name</td>
                                @if (User.IsInRole("Admin"))
                                {
                                    <td class="text-end pe-4">
                                        <a asp-action="Edit" asp-route-id="@item.CategoryId" class="text-decoration-none me-3 text-primary">Edit</a>
                                        <a asp-action="Delete" asp-route-id="@item.CategoryId" class="text-decoration-none text-danger">Delete</a>
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>