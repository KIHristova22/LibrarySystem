@{
    Layout = null;
    ViewData["Title"] = "Server error";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <style>
        body {
            margin: 0;
            min-height: 100vh;
            display: grid;
            place-items: center;
            background: #f8f9fa;
            color: #212529;
            font-family: Arial, sans-serif;
        }

        main {
            max-width: 620px;
            padding: 32px;
            text-align: center;
            background: white;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        }

        h1 {
            color: #dc3545;
        }

        a {
            display: inline-block;
            margin-top: 16px;
            padding: 10px 18px;
            border-radius: 6px;
            background: #0d6efd;
            color: white;
            text-decoration: none;
        }
    </style>
</head>
<body>
<main>
    <h1>500 — Something went wrong</h1>
    <p>
        An unexpected error occurred. Your information was not exposed,
        and the incident was recorded for the administrator.
    </p>
    <a href="/">Return to the library</a>
</main>
</body>
</html>