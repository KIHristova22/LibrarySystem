@model Library.ViewModels.ReportsViewModel

@{
    ViewData["Title"] = "Reports & Analytics";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1 class="h2 fw-bold mb-1">Reports &amp; Analytics</h1>
            <p class="text-muted mb-0">Borrowing overview for @Model.Year</p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-action="ExportToExcel" class="btn btn-success">
                Export to Excel
            </a>
            <a asp-action="ExportToPdf" class="btn btn-danger">
                Export to PDF
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Total Borrows</div>
                    <div class="display-6 fw-bold">@Model.TotalBorrows</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Active Loans</div>
                    <div class="display-6 fw-bold">@Model.ActiveLoans</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Returned Borrows</div>
                    <div class="display-6 fw-bold">@Model.ReturnedBorrows</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Registered Users</div>
                    <div class="display-6 fw-bold">@Model.TotalRegisteredUsers</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Top Category</div>
                    <div class="h3 fw-bold mb-0">@Model.TopCategory</div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Most Borrowed Book</div>
                    <div class="h3 fw-bold mb-0">
                        @(Model.TopBooks.FirstOrDefault()?.Title ?? "No data")
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <section class="card h-100 shadow-sm">
                <div class="card-header bg-white">
                    <h2 class="h5 mb-0">Monthly Borrowing — @Model.Year</h2>
                </div>
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Month</th>
                                <th scope="col" class="text-end">Borrows</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var month in Model.MonthlyStatistics)
                            {
                                <tr>
                                    <td>@month.Month</td>
                                    <td class="text-end">@month.BorrowCount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        <div class="col-lg-6">
            <section class="card h-100 shadow-sm">
                <div class="card-header bg-white">
                    <h2 class="h5 mb-0">Top 5 Borrowed Books</h2>
                </div>
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Book</th>
                                <th scope="col">Author</th>
                                <th scope="col" class="text-end">Borrows</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.TopBooks.Count == 0)
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-muted py-4">
                                        No borrowing data yet.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var book in Model.TopBooks)
                                {
                                    <tr>
                                        <td>@book.Title</td>
                                        <td>@book.AuthorName</td>
                                        <td class="text-end">@book.BorrowCount</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </div>
</div>