<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LibrarySystem</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <header class="bg-white border-bottom shadow-sm py-3 mb-4">
        <div class="container d-flex justify-content-between align-items-center">
            <div>
                <a class="fs-4 fw-bold text-dark text-decoration-none" asp-controller="Books" asp-action="Index">LibrarySystem</a>
                <div class="text-muted small">Book register</div>
            </div>
            <nav class="nav align-items-center">
                <a class="nav-link text-dark fw-medium" asp-controller="Books" asp-action="Index">Books</a>
                <a class="nav-link text-dark fw-medium" asp-controller="Authors" asp-action="Index">Authors</a>
                <a class="nav-link text-dark fw-medium" asp-controller="Categories" asp-action="Index">Categories</a>
                
                @if (SignInManager.IsSignedIn(User))
                {
                    <span class="ms-3 text-muted small">Hello, @User.Identity?.Name!</span>
                    <form class="d-inline ms-2" asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Logout</button>
                    </form>
                }
                else
                {
                    <a class="btn btn-sm btn-outline-primary ms-3" asp-controller="Account" asp-action="Login">Login</a>
                    <a class="btn btn-sm btn-primary ms-2" asp-controller="Account" asp-action="Register">Register</a>
                }
            </nav>
        </div>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>